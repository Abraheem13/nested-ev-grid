# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# Downloaded data (fetched and checksum-verified by nflev.data.sources)
data/cache/

# Quick check run (python reproduce.py --quick)
artifacts_quick/

# Training-time files: console logs, resumable checkpoints, learning-curve snapshots
artifacts/logs/
artifacts/runs/*/checkpoint.pt
artifacts/runs/*/checkpoint.tmp
artifacts/runs/*/snapshot_ep*.pt
artifacts/tuning/*/s*.log
artifacts/tuning/*/s*/checkpoint.pt
artifacts/tuning/*/s*/checkpoint.tmp
artifacts/tuning/*/s*/snapshot_ep*.pt

# LaTeX build files
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Editors and operating systems
.DS_Store
.vscode/
.idea/
